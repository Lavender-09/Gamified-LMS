                                    </ul>
                                </li>
                            </asp:Panel>

                     <li class="nav-item"><a class="nav-link" runat="server" id="hyregister"
                                href="~/register">Register</a></li>
                        </ul>
                    </div>

                    <asp:Panel runat="server" ID="lgregis">
                        <asp:Label runat="server" ID="lbllgged"></asp:Label>
                        <asp:Button runat="server" ID="btnlgout" Text="Log out"
                            CssClass="btn btn-outline-info" Visible="false" OnClick="btnlgout_Click" />
                    </asp:Panel>

                    <!-- END OF PANELS -->

                </div>
        <div class="container-fluid d-lg-none">
            <div class="d-flex  align-items-end mt-3">
                <ul class="d-flex  align-items-center list-unstyled m-0">
