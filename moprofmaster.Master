<asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
<body>
<form runat="server">
    <asp:ScriptManager ID="ScriptManager1" runat="server" />

    <!-- navbar start -->

    <nav class="main-menu d-flex navbar navbar-expand-lg p-2 py-3 p-lg-4 py-lg-4 ">
        <div class="container-fluid">
            <div class="main-logo d-lg-none">
                <a href="<%=ResolveClientUrl("~/default") %>" class="navbar-brand ml-lg-3">
                    <h1 class="m-0 text-uppercase text-primary"><i class="fa fa-book-reader mr-3"></i>MoProf</h1>
                </a>
            </div>

                    <ul class="navbar-nav menu-list list-unstyled align-items-lg-center d-flex gap-md-3 mb-0">
                        <li class="nav-item" id="hyhome">

                            <asp:HyperLink CssClass="nav-link mx-2 active"
    runat="server" ID="hydefault" Visible="true"
    NavigateUrl="~/default.aspx">Home</asp:HyperLink>
                        </li>

                        <asp:Panel ID="pnlStudents" runat="server" CssClass="nav navbar-nav" Visible="false">
                        <li class="nav-item dropdown">
                            <a class="nav-link mx-2 dropdown-toggle align-items-center" role="button" id="pages"
                                data-bs-toggle="dropdown" aria-expanded="false">Student Pages</a>
                            <ul class="dropdown-menu" aria-labelledby="pages">
                                <li><a href="<%=ResolveClientUrl("~/viewtutors") %>" class="dropdown-item">List of Tutors</a></li>
                                <li><a class="dropdown-item" href="<%=ResolveClientUrl("~/searchtutor") %>">Search For Tutors</a></li>
                            </ul>
                        </li> 
                            
                            <li class="nav-item dropdown">
                            <a class="nav-link mx-2 dropdown-toggle align-items-center" role="button" id="courses"
                                data-bs-toggle="dropdown" aria-expanded="false">Courses</a>
                            <ul class="dropdown-menu" aria-labelledby="courses">
                                <li><a href="<%=ResolveClientUrl("~/courses") %>" class="dropdown-item">Course</a></li>
                                <li><a href="<%=ResolveClientUrl("~/searchsubject") %>" class="dropdown-item">Search for Subject</a></li>
                                <li><a href="<%=ResolveClientUrl("~/categories") %>" class="dropdown-item">Course Categories</a></li>
                            </ul>
                        </li>

                        </asp:Panel>

                        
                        <asp:Panel ID="pnlTutors" runat="server" CssClass="nav navbar-nav" Visible="false">
