                                <li role="separator" class="divider"></li>
                                <li>
    <asp:HyperLink CssClass="dropdown-item"
        runat="server" ID="hydash" Visible="false"
        NavigateUrl="~/dashboard.aspx">Dashboard</asp:HyperLink></li>
<li role="separator" class="divider"></li>
                                    <asp:HyperLink CssClass="dropdown-item"
        runat="server" ID="hytutdash" Visible="false"
        NavigateUrl="~/tutordashboard.aspx">Tutor Dashboard</asp:HyperLink></li>
<li role="separator" class="divider"></li>
                                                               
                                <li>
                                    <asp:LinkButton ID="lnkdeac" runat="server" CssClass="btn btn-outline-danger" OnClientClick="return confirm('Are you sure you want to deactivate your account? You will be logged out and will have to reactivate to continue using.')" OnClick="lnkdeac_Click">Deactivate Account</asp:LinkButton>
                                    </li>
                            </ul>
                        </li>
                    </asp:Panel>
                    <!--menu to manage users-->
                    <asp:Panel runat="server" class="nav navbar-nav" ID="pnlmanagemov"
