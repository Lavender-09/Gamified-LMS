false">Site Management<span class="caret"></span></a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="<%=
ResolveClientUrl("~/userview") %>">View Users</a></li>
                                                                <li><a class="dropdown-item" href="<%=
ResolveClientUrl("~/searchuser") %>">Search For Users</a></li>
                                                                                                <li><a class="dropdown-item" href="<%=
ResolveClientUrl("~/admindashboard") %>">Admin Dashboard</a></li>
                            </ul>

                        </li>
                    </asp:Panel>
                    
                    <div class="navbar-collapse flex-grow-1 text-right" id="myNavbar">
                        <ul class="navbar-nav ms-auto flex-nowrap">

                    <asp:Panel runat="server" ID="pnllog">
                                <li class="nav-item dropdown">
                                    <a href="#" class="nav-link dropdown-toggle"
