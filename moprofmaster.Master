                                <li><a href="<%=ResolveClientUrl("~/categories") %>" class="dropdown-item">Course Categories</a></li>
                            </ul>
                        </li>

                        </asp:Panel>

                    </ul>
                    <!--START OF PANELS -->

                    <!-- Menu to view user profile -->
                    <asp:Panel runat="server" class="nav navbar-nav" ID="pnlprofile"
                        Visible="false">
                        <li class="dropdown">
                            <a href="#" class="nav-link dropdown-toggle"
                                data-bs-toggle="dropdown" role="button" aria-haspopup="true" ariaexpanded="
false">User Info<span class="caret"></span></a>
                            <ul class="dropdown-menu">
                                <li>
                                    <asp:HyperLink CssClass="dropdown-item"
                                        runat="server" ID="hyuser"
